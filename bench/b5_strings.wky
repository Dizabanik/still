import stdc;

// Text scan over fat-string views: tokenize an in-place corpus, hash each
// word with FNV-1a over its bytes, fold into an accumulator, and take
// content comparisons on every 16th word against a literal.
const str CORPUS = "the quick brown fox jumps over the lazy dog the quick brown fox pack my box with five dozen liquor jugs pack my box with five how vexingly quick daft zebras jump how vexingly quick daft zebras sphinx of black quartz judge my vow sphinx of black quartz judge ";

fn u32 fnv(str w) {
    u32 h = 2166136261;
    for (u32 i = 0; i < w.len; i += 1) {
        h = wrap_mul(h ^ (u32)w.data[i], 16777619);
    }
    return h;
}

fn i32 main() {
    const i64 ROUNDS = 2000000;
    const u32 clen = CORPUS.len;
    u64 acc = 0;
    u32 words = 0;
    for (i64 r = 0; r < ROUNDS; r += 1) {
        u32 i = 0;
        while (i < clen) {
            while (i < clen && CORPUS.data[i] == ' ') { i += 1; }
            u32 start = i;
            while (i < clen && CORPUS.data[i] != ' ') { i += 1; }
            u32 wlen = i - start;
            if (wlen > 0) {
                // word view over the corpus buffer
                str w;
                w.data = &CORPUS.data[start];
                w.len = wlen;
                acc += fnv(w);
                words += 1;
                if ((words & 15) == 0 && w == "quick") {
                    acc += 7;
                }
            }
        }
        acc += r; // defeat any whole-loop elision
    }
    stdc.printf("acc=%llu words=%u\n", acc, words);
    return 0;
}
