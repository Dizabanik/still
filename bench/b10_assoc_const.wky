import stdc;

struct Mat4 {
    i32 dummy;
}

impl Mat4 {
    const DIM = 4;
    const SIZE = 16;
}

fn i32 main() {
    const i64 ROUNDS = 20000000;
    let m: [Mat4.SIZE]i64;
    for (i64 i = 0; i < Mat4.SIZE; i += 1) {
        m[i] = (i * 7 + 3) & 15;
    }

    let v: [Mat4.DIM]i64;
    v[0] = 1;
    v[1] = 2;
    v[2] = 3;
    v[3] = 4;

    let acc: i64 = 0;
    for (i64 r = 0; r < ROUNDS; r += 1) {
        let out: [Mat4.DIM]i64;
        for (i64 row = 0; row < Mat4.DIM; row += 1) {
            let sum: i64 = 0;
            for (i64 col = 0; col < Mat4.DIM; col += 1) {
                sum += m[row * Mat4.DIM + col] * v[col];
            }
            out[row] = sum;
        }
        v[0] = (out[0] ^ r) & 65535;
        v[1] = out[1] & 65535;
        v[2] = (out[2] + 1) & 65535;
        v[3] = (out[3] ^ (r >> 2)) & 65535;
        acc = (acc * 31 + v[0] + v[1] + v[2] + v[3]) & 2147483647;
    }

    stdc.printf("acc=%lld\n", acc);
    return 0;
}
