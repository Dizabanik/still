import stdc;
// Inputs are runtime decimal integers: iterations, seed, active length (1..4096).
fn i64 input(i32 arg) {
    // arg_at currently returns a raw C string; the UTF-8 view API has a separate failing contract.
    char* text = std.process.arg_at(arg);
    i64 value = 0;
    for (i64 i = 0; text[i] != 0; i += 1) { value = value * 10 + ((i64)text[i]) - 48; }
    return value;
}

fn i32 main() {
    i64 rounds=input(1); i64 seed=input(2); [16]i64 m; [4]i64 v;
    for(i64 i=0;i<16;i+=1) { m[i]=(i*7+seed)&15; }
    for(i64 i=0;i<4;i+=1) { v[i]=(seed+i)&65535; }
    i64 acc=0;
    for(i64 r=0;r<rounds;r+=1) {
        [4]i64 out;
        for(i64 row=0;row<4;row+=1) { i64 sum=0;
            for(i64 col=0;col<4;col+=1) { sum+=m[row*4+col]*v[col]; }
            out[row]=(sum+r)&65535;
        }
        for(i64 i=0;i<4;i+=1) { v[i]=out[i]; acc=(acc*31+v[i])&2147483647; }
    }
    println("{acc} {v[0]} {v[3]}"); return 0;
}
