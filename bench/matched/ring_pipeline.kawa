import stdc;
// Inputs are runtime decimal integers: iterations, seed, active length (1..4096).
fn i64 input(i32 arg) {
    // arg_at currently returns a raw C string; the UTF-8 view API has a separate failing contract.
    char* text = std.process.arg_at(arg);
    i64 value = 0;
    for (i64 i = 0; text[i] != 0; i += 1) { value = value * 10 + ((i64)text[i]) - 48; }
    return value;
}

fn i32 main() {
    i64 rounds=input(1); i64 seed=input(2); [64]i64 a; [64]i64 b; [64]i64 c;
    i64 sent=0; i64 acc=0;
    while(sent<rounds) {
        i64 count=rounds-sent; if(count>64) { count=64; }
        for(i64 i=0;i<count;i+=1) { a[i]=((sent+i+seed)*3+1)&2147483647; }
        for(i64 i=0;i<count;i+=1) { b[i]=(a[i]*3+1)&2147483647; }
        for(i64 i=0;i<count;i+=1) { c[i]=(b[i]*3+1)&2147483647; }
        for(i64 i=0;i<count;i+=1) { acc=(acc+c[i])&2147483647; }
        sent+=count;
    }
    println("{acc}"); return 0;
}
