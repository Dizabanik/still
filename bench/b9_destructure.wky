import stdc;

struct Point {
    i64 x;
    i64 y;
}

struct Pair {
    i64 first;
    i64 second;
}

unsafe fn i32 main() {
    const i64 ROUNDS = 50000000;
    i64 acc = 123456789;

    for (i64 r = 0; r < ROUNDS; r += 1) {
        let pt = Point { x: (acc ^ r) & 65535, y: ((acc >> 16) ^ r) & 65535 };

        // 1. Named struct destructuring
        let Point { x, y } = pt;

        // 2. Renamed struct destructuring
        let Point { x: px, y: py } = pt;

        // 3. Inferred struct destructuring
        let { x: ix, y: iy } = Point { x: px + 1, y: py + 2 };

        // 4. Positional struct destructuring
        let p = Pair { first: x * 3 + iy, second: y * 5 + ix };
        let (p1, p2) = p;

        // 5. Positional array destructuring
        [2]i64 arr;
        arr[0] = p1 ^ p2;
        arr[1] = p1 + p2;
        let (a0, a1) = arr;

        acc = (acc * 31 + a0 + a1) & 2147483647;
    }

    stdc.printf("acc=%lld\n", acc);
    return 0;
}
