// Equal-policy benchmark: the C version uses the same descriptor runtime.
fn i64 input(i32 arg) {
    str text=std.process.arg_at(arg); i64 value=0;
    for (i64 i=0; i<text.len; i+=1) { value=value*10+(i64)text[i]-48; }
    return value;
}
fn i64 checked_walk(ref<i64> p, i64 rounds, i64 seed, i64 mask, i64 scatter) {
    i64 total=0;
    for (i64 i=0; i<rounds; i+=1) {
        i64 index=(scatter!=0 ? i*1664525+seed : i+seed)&mask;
        total+=p[index];
    }
    return total;
}
fn i64 stable_walk(ref<i64> p, i64 rounds, i64 seed, i64 mask, i64 scatter) {
    i64 total=0;
    stable(p) {
        for (i64 i=0; i<rounds; i+=1) {
            i64 index=(scatter!=0 ? i*1664525+seed : i+seed)&mask;
            total+=p[index];
        }
    }
    return total;
}
fn main() {
    i64 rounds=input(1); i64 seed=input(2); i64 size=input(3);
    i64 mode=input(4); i64 scatter=input(5);
    if (rounds>1000000000 || seed>65535 || size<1 || size>1048576 || (size&(size-1))!=0 || mode>1 || scatter>1) { return 2; }
    let a: owner<i64> = own(size); let p=ref_of(a);
    stable(p) { for (i64 i=0; i<size; i+=1) { p[i]=i*17+seed; } }
    let before_checks=mem_metric(7); let before_pins=mem_metric(8);
    i64 total=0;
    if (mode==0) { total=checked_walk(p,rounds,seed,size-1,scatter); }
    else { total=stable_walk(p,rounds,seed,size-1,scatter); }
    let after_checks=mem_metric(7); let after_pins=mem_metric(8);
    release(a);
    println("{total} {mem_metric(0)} {mem_metric(1)} {mem_metric(2)} {before_checks} {after_checks} {before_pins} {after_pins} {mem_metric(4)}");
    return 0;
}
