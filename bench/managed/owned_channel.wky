// Runtime inputs and sized argument views keep setup outside the kernels' contracts.
fn u64 input(i32 arg) {
 str text=std.process.arg_at(arg); u64 value=0;
 for(i64 i=0;i<text.len;i+=1) { value=value*10+(u64)text[i]-48; }
 return value;
}
fn main() {
 u64 rounds=input(1), seed=input(2), capacity=input(3);
 if(rounds>100000000 || seed>65535 || capacity<1 || capacity>256) {return 2;}
 u64 checksum=0, counted=0;
 { chan<owner<u64>> pipe=make_chan(capacity);
  for(u64 base=0;base<rounds;base+=capacity) {
   u64 available=rounds-base<capacity ? rounds-base : capacity;
   for(u64 i=0;i<available;i+=1) {owner<u64> item=own(1); item[0]=seed+base+i; pipe<-move(item);}
   for(u64 i=0;i<available;i+=1) {owner<u64> item=<-pipe; checksum+=item[0]*((base+i)%97+7); counted+=1;}
  }
 }
 println("{checksum} {counted} {mem_metric(0)} {mem_metric(1)} {mem_metric(2)} {mem_metric(3)} {mem_metric(5)} {mem_metric(7)} {mem_metric(4)}");
 return 0;
}
