// Equal-policy lifecycle workload; C uses the same descriptor runtime.
struct Node { u64 value; owner<Node> child; }
fn u64 input(i32 arg) {
    str text=std.process.arg_at(arg);
    u64 value=0;
    for (i64 i=0; i<text.len; i+=1) { value=value*10+(u64)text[i]-48; }
    return value;
}
fn u64 chain_sum(ref<Node> current) {
    u64 sum=0;
    while (allocated(current) && mem_len(current)!=0) {
        sum+=current[0].value;
        current=ref_of(current[0].child);
    }
    return sum;
}
fn u64 fanout_sum(ref<owner<u64>> current) {
    u64 sum=0;
    for (u64 i=0; i<mem_len(current); i+=1) { sum+=current[i][0]; }
    return sum;
}
fn main() {
    u64 size=input(1); u64 trials=input(2); u64 seed=input(3); u64 shape=input(4);
    if (size>1000000 || trials<1 || trials>100 || seed>65535 || shape>1) { return 2; }
    u64 originals=0; u64 copies=0;
    for (u64 trial=0; trial<trials; trial+=1) {
        if (shape==0) {
            let root: owner<Node> = own(size==0 ? 0 : 1);
            if (size!=0) { root[0].value=seed; }
            for (u64 i=1; i<size; i+=1) {
                let head: owner<Node> = own(1);
                head[0].value=i*17+seed;
                head[0].child=move(root);
                root=move(head);
            }
            let copy=clone(root);
            if (size!=0) { copy[0].value+=1; }
            originals+=chain_sum(ref_of(root));
            copies+=chain_sum(ref_of(copy));
        } else {
            let root: owner<owner<u64>> = own(size);
            for (u64 i=0; i<size; i+=1) {
                root[i]=own(1);
                root[i][0]=i*17+seed;
            }
            let copy=clone(root);
            if (size!=0) { copy[0][0]+=1; }
            originals+=fanout_sum(ref_of(root));
            copies+=fanout_sum(ref_of(copy));
        }
    }
    println("{originals} {copies} {mem_metric(0)} {mem_metric(1)} {mem_metric(2)} {mem_metric(3)} {mem_metric(5)} {mem_metric(4)} {mem_metric(7)}");
    return 0;
}
