root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[{*.c,*.h,Makefile}]
indent_style = tab

[*.wky.out]
insert_final_newline = unset
trim_trailing_whitespace = false
