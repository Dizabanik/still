# Out-of-tree and accidental in-source CMake/Make builds.
/build/
/build-*/
/dist/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/CTestTestfile.cmake
/Testing/
/compile_commands.json
/still
/still_debug
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.d
*.dSYM/

# LLVM intermediates, profiles and generated runtime headers.
*.bc
*.ll
*.profraw
*.profdata
*.gcda
*.gcno
/optimization.json
/src/codegen/wky_runtime_bc.h

# Historical benchmark executables; source triples remain versioned.
/bench/*_c
/bench/*_rs
/bench/b1_hash
/bench/b2_mem
/bench/b3_particles
/tests/test
/tests/test_attrs

# Python environments and local test/tool caches.
__pycache__/
*.py[cod]
.venv/
venv/
/tools/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.lit_test_times.txt

# Local scratch files, assistant state and OS metadata.
/tmp/
.cache/
.claude/
.codex/
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
.env
.env.*
!.env.example

# Do not ignore *.out: tests/*.wky.out are byte-exact output fixtures.
