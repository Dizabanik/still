#[noalloc]
fn void transfer(ref<owner<i64>> destination, owner<i64> incoming) {
    destination[0] = move(incoming);
}
fn main() {
    let root: owner<owner<i64>> = own(1);
    root[0] = own(2);
    let next: owner<i64> = own(1);
    next[0] = 97;
    transfer(ref_of(root), move(next));
    println("{root[0][0]}");
    release(root);
    println("{mem_metric(2)} {mem_metric(0)==mem_metric(1)}");
    return 0;
}
