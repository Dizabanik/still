// str = {ptr,len} view (IDEAS 3): literals are a constant global plus a
// constant pair -- O(1) length, zero runtime setup. Comparison folds to
// memcmp over the min length with a length tiebreak (no strcmp scan).
//
// OPT: 0
import stdc;

fn i32 main() {
    let a = "kawa";
    let b = "coffee";
    if (a < b) {
        printf("%lld %lld\n", a.len, b.len);
    }
    return 0;
}

// CHECK: @.strlit.0 = private unnamed_addr constant [5 x i8] c"kawa\00"
// CHECK-NOT: call {{.*}} @strlen
// CHECK-LABEL: define i32 @kawa_main
// CHECK: call i32 @memcmp
// CHECK-NOT: call i32 @strcmp
