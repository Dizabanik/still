// Release builds emit NO bounds check for slice indexing: zero cost by
// construction. (The dynamic-length trap path is exercised by --debug
// binaries and verified in test_slices.)
//
// OPT: 2
import stdc;

fn i32 main() {
    [3]i32 a = { 1, 2, 3 };
    []i32 s = a;
    printf("%d\n", s[1]);
    return 0;
}

// CHECK-NOT: kawa_trap
