// Dynamic indexing must retain the checked failure path in a safe optimized build.
// OPT: 2
// FLAGS: --bounds-check=safe
pub fn i64 checked_read([]i64 values, i64 index) { return values[index]; }
pub fn i32 main() { [2]i64 a = {1,2}; println("{checked_read(a,1)}"); return 0; }
// CHECK-LABEL: define i64 @checked_read(
// CHECK: icmp ult i64
// CHECK: call void @wky_trap
