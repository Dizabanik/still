// OPT: 3
// FLAGS: --bounds-check=safe
pub fn i64 matrix([16]i64 m, [4]i64 v, i64 rounds) {
    i64 acc=0;
    for(i64 r=0;r<rounds;r+=1) {
        [4]i64 out;
        for(i64 row=0;row<4;row+=1) { i64 sum=0;
            for(i64 col=0;col<4;col+=1) { sum+=m[row*4+col]*v[col]; }
            out[row]=(sum+r)&65535;
        }
        for(i64 i=0;i<4;i+=1) { v[i]=out[i]; acc=(acc*31+v[i])&2147483647; }
    }
    return acc;
}
pub fn i32 main() { [16]i64 m; [4]i64 v;
    for(i64 i=0;i<16;i+=1) { m[i]=(i*7+42)&15; }
    for(i64 i=0;i<4;i+=1) { v[i]=(42+i)&65535; }
    println("{matrix(m,v,100)}"); return 0;
}
// CHECK-LABEL: define {{.*}} @matrix(
// CHECK-NOT: alloca
// CHECK-NOT: @llvm.memcpy
// CHECK: ret i64
