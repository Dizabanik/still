// Unsigned+unsigned arithmetic wraps (C semantics) and carries NO nuw flag
// -- `u8 200 + 100` under nuw produced poison. Signed operations use an
// overflow intrinsic followed by a checked trap, without poison flags.
//
// OPT: 0
import stdc;

#[unsafe]

fn i32 main() {
    u32 x = 4000000000;
    u32 y = 1;
    let t = x + y; // unsigned add: plain add, no nuw
    i32 a = 5;
    let z = a + 1;
    printf("%d %d\n", lossy_i32(t), z);
    return 0;
}

// CHECK: %wrap_add = add i32
// CHECK-NOT: add nuw
// CHECK-NOT: sub nuw
// CHECK-NOT: mul nuw
// CHECK: call { i32, i1 } @llvm.sadd.with.overflow.i32
