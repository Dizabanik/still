// chan<T> blocking ops: a full-ring send suspends the enclosing
// coroutine and RESUMES INTO A RE-CHECK of capacity -- the check block is a
// loop header, so every wake-up re-reads count fresh from the channel record.
// All suspend-exit arms converge on one coro.end block (the clang contract
// that keeps coro-split rewriting exits per-funclet).
//
// OPT: 0
import stdc;
chan<i32> pipe = make_chan(1);
@unsafe
fn i32 main() {
    let t = brew {
        pipe <- 1;
        pipe <- 2;
        drop(7);
    };
    sip(t);
    i32 v = <-pipe;
    printf("%d\n", v);
    sip(t);
    return 0;
}

// CHECK-LABEL: define internal fastcc void @wky_task_{{[0-9]+}}.resume
// CHECK: channel_check:
// CHECK: br i1 %channel_unavailable{{.*}}, label %{{[^,]+}}, label %channel_ready
// CHECK: br label %channel_check
