// chan<T> blocking ops (IDEAS 3): a full-ring send suspends the enclosing
// coroutine and RESUMES INTO A RE-CHECK of capacity -- the check block is a
// loop header, so every wake-up re-reads count fresh from the channel record.
// All suspend-exit arms converge on one coro.end block (the clang contract
// that keeps coro-split rewriting exits per-funclet).
//
// OPT: 0
import stdc;
chan<i32> pipe = make_chan(1);
fn i32 main() {
    let t = brew {
        pipe <- 1;
        pipe <- 2;
        drop(7);
    };
    sip(t);
    i32 v = <-pipe;
    printf("%d\n", v);
    sip(t);
    return 0;
}

// CHECK-LABEL: define ptr @wky_task
// CHECK: send_check:
// CHECK: br i1 %is_full, label %{{.*}}, label %send_put
// CHECK-LABEL: define void @wky_trap
