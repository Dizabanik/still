// Built-in reductions lower to `define internal i64 @wky.sum.<T>(ptr, i64)`
// with a canonical single-recurrence loop -- the shape LoopVectorize reduces.
//
// OPT: 0
import stdc;

@unsafe

fn i32 main() {
    [8]i32 xs = {1, 2, 3, 4, 5, 6, 7, 8};
    printf("s=%lld m=%d\n", sum(xs), max(xs));
    return 0;
}

