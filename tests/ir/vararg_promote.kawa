// C varargs default argument promotions: signed narrow ints SIGN-extend
// (%d of an i16 -600 printed 64936 under a zext), unsigned zero-extend.
//
// OPT: 0
import stdc;

fn i32 main() {
    i16 s = -300;
    u8 b = 200;
    printf("%d %d\n", s, b);
    return 0;
}

// CHECK: %vararg_prom = sext i16
// CHECK: %vararg_prom{{[0-9]*}} = zext i8
