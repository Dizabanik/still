// Same program at -O3: both operands are constants, so the comparison and
// printf fold away entirely -- no memcmp call survives optimization.
//
// OPT: 3
import stdc;

fn i32 main() {
    let a = "wky";
    let b = "coffee";
    if (a < b) {
        printf("%lld %lld\n", a.len, b.len);
    }
    return 0;
}

// CHECK-LABEL: define noundef i32 @main
// CHECK-NOT: call i32 @memcmp
