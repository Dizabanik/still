fn main() {
    let root: owner<owner<i64>> = own(2);
    root[0] = own(2);
    root[1] = own(1);
    root[0][0] = 67;
    root[1][0] = 71;
    let before = mem_metric(2);
    for (i64 i=0; i<88; i+=1) {
        mem_budget(i);
        let failed = try_clone(root);
        if (allocated(failed) || mem_metric(2)!=before) { return 1; }
        if (root[0][0]!=67 || root[1][0]!=71) { return 2; }
    }
    mem_budget(88);
    let complete = try_clone(root);
    complete[0][0] = 89;
    println("{root[0][0]} {complete[0][0]} {complete[1][0]}");
    release(root);
    release(complete);
    println("{mem_metric(2)} {mem_metric(0)==mem_metric(1)}");
    return 0;
}
