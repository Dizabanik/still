alias Integer=i64;
alias Buffer=owner<Integer>;
alias Borrowed=ref<Integer>;
fn i64 read(ref<i64> value) { return value[0]; }
fn main() {
    Buffer original=own(1);
    original[0]=42;
    Borrowed borrowed=ref_of(original);
    owner<i64> concrete=move(original);
    println("{read(borrowed)} {concrete[0]}");
    return 0;
}
