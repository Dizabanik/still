alias Integer=i64;
alias Buffer=owner<Integer>;
alias Borrowed=ref<Integer>;
fn i64 read(ref<i64> value) { return value[0]; }
fn main() {
    let original:Buffer=own(1);
    original[0]=42;
    let borrowed:Borrowed=ref_of(original);
    let concrete:owner<i64>=move(original);
    println("{read(borrowed)} {concrete[0]}");
    return 0;
}
