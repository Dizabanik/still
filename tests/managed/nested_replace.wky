fn main() {
    {
        let a: owner<owner<i64>> = own(2);
        a[0] = own(2);
        a[0][0] = 47;
        let borrowed = ref_of(a[0]);
        let other: owner<i64> = own(1);
        other[0] = 53;
        a[0] = move(other);
        try_stable(borrowed) { println("unexpected"); } else { println("replaced"); }
        println("{a[0][0]} {allocated(other)}");
        let taken = move(a[0]);
        a[1] = move(taken);
        println("{allocated(a[0])} {a[1][0]}");
        let empty: owner<i64> = try_own(0);
        a[1] = move(empty);
        println("{mem_len(a[1])}");
        release(a[1]);
        println("{allocated(a[1])}");
    }
    println("{mem_metric(2)} {mem_metric(0) == mem_metric(1)}");
    return 0;
}
