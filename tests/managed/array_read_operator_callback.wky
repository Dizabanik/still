struct Row { [2]i64 values; }
struct Index { ref<Row> victim; }
impl Index {
    fn i64 self_add(Index left, Index right) { remove(left.victim); return 0; }
}
fn main() {
    arena region=arena();
    ref<Row> row=arena_new(region,1);
    row[0].values[0]=31;
    Index index={victim:row};
    println("{row[0].values[index+index]}");
    return 0;
}
