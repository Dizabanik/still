struct Inner { i64 value; owner<i64> child; }
struct Record { i64 id; owner<Inner> child; [2]owner<i64> branches; }
fn main() {
    {
        owner<Record> rows = own(3);
        rows[0].id = 11;
        rows[0].child = own(2);
        rows[0].child[1].value = 17;
        rows[0].child[1].child = own(2);
        rows[0].child[1].child[0] = 23;
        rows[0].branches[1] = own(1);
        rows[0].branches[1][0] = 29;
        rows[2].branches[0] = own(1);
        rows[2].branches[0][0] = 31;
        let borrowed = ref_of(rows[0].child[1].child);
        let copy = clone(rows);
        copy[0].child[1].child[0] = 101;
        println("{rows[0].id} {rows[0].child[1].value} {borrowed[0]} {copy[0].child[1].child[0]} {copy[0].branches[1][0]}");
        let view = ref_slice(ref_of(rows), 1, 3);
        let tail = clone(view);
        println("{mem_len(tail)} {allocated(tail[0].child)} {tail[1].branches[0][0]}");
        let detached = move(rows[0].child);
        println("{allocated(rows[0].child)} {detached[1].child[0]}");
        release(rows);
        println("{detached[1].value} {borrowed[0]}");
        release(detached);
        try_stable(borrowed) { println("unexpected"); } else { println("removed"); }
    }
    println("{mem_metric(2)} {mem_metric(0) == mem_metric(1)}");
    return 0;
}
