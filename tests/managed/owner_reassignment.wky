struct Node { i64 value; owner<Node> child; }
fn main() {
    let root: owner<Node> = own(1);
    let removed = ref_of(root);
    root = own(1);
    try_stable(removed) { println("unexpected"); } else { println("replaced"); }
    root = move(root);
    for (i64 i=1; i<10000; i+=1) {
        let head: owner<Node> = own(1);
        head[0].value = i;
        head[0].child = move(root);
        root = move(head);
    }
    let copy = clone(root);
    i64 sum=0;
    let current=ref_of(copy);
    while (allocated(current)) {
        sum+=current[0].value;
        current=ref_of(current[0].child);
    }
    println("{sum}");
    release(root); release(copy);
    root = own(1);
    root[0].value = 113;
    println("{root[0].value}");
    release(root);
    println("{mem_metric(2)} {mem_metric(0)==mem_metric(1)}");
    return 0;
}
