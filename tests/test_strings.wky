#!/usr/bin/env wky run
// String relations compare CONTENT (strcmp), not pointers -- including
// strings built at runtime. Escapes cover \n \t \r \0 \" \' \\ \xNN.
import stdc;

fn int main() {
    let a = "apple";
    let same = "apple";
    let b = "banana";

    if (a == same) {
        stdc.printf("eq\n");
    }
    if (a != b) {
        stdc.printf("ne\n");
    }
    if (a < b) {
        stdc.printf("lt\n");
    }
    if (b >= a) {
        stdc.printf("ge\n");
    }

    // Runtime-built string: content comparison must not depend on address.
    // A concat builds a fresh buffer; the result compares by CONTENT.
    let joined = a + " pie";
    if (joined == "apple pie") {
        stdc.printf("runtime eq\n");
    }
    stdc.printf("joined=%s len=%lld\n", joined.data, joined.len);

    stdc.printf("%s\n", "tab:\tx");
    stdc.printf("%s\n", "hex:\x41\x42");
    return 0;
}
