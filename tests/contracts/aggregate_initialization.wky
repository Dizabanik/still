struct Record { i32 a=3; i32 b=5; i32 c; }
const Record global={.c=11,.a=7};
const Record spread={..global,19};
const [4]i32 partial={13,17};
let calls:i32=0;
fn i32 next(){calls=calls+1;return calls;}
struct Defaults { i32 a=next(); i32 b=next(); }
struct Nested { Record record; [3]i32 values; }
const Nested nested={.values={29},.record={.c=23}};
fn main(){
    Record local={.c=11,.a=7};
    Record copied={..local,19};
    Record mixed={.b=31,37,41};
    [4]i32 local_array={13,17};
    Defaults defaults={.a=43};
    println("{global.a} {global.b} {global.c} {spread.a} {spread.b} {spread.c}");
    println("{local.a} {local.b} {local.c} {copied.a} {copied.b} {copied.c}");
    println("{mixed.a} {mixed.b} {mixed.c}");
    println("{partial[0]} {partial[1]} {partial[2]} {partial[3]} {local_array[2]} {local_array[3]}");
    println("{nested.record.a} {nested.record.b} {nested.record.c} {nested.values[0]} {nested.values[1]} {nested.values[2]}");
    println("{defaults.a} {defaults.b} {calls}");
    return 0;
}
