struct Item { i64 tag; [2]owner<i64> data; }
fn Item make(i64 n) { return {tag:n, data:{own(1),own(1)}}; }
@noalloc fn i64 consume(Item value) { return value.tag; }
fn i64 early() {
    Item a = make(3);
    defer println("defer {a.tag} {allocated(a.data[0])}");
    return 7;
}
fn main() {
    ref<i64> stale;
    for (i64 i=0; i<3; i=i+1) {
        Item item = make(i);
        stale=ref_of(item.data[0]);
        if (i==0) { continue; }
        break;
    }
    try_stable(stale) { println("unexpected"); } else { println("loop cleaned"); }
    filter {
        Item item = make(5);
        stale=ref_of(item.data[0]);
        press error=13;
    } dregs (error) { println("{error}"); }
    try_stable(stale) { println("unexpected"); } else { println("error cleaned"); }
    println("{early()}");
    println("{consume(make(17))}");
    make(19);
    Item item=make(23);
    let copied=try_clone(item);
    println("{copied.tag} {allocated(copied.data[1])}");
    mem_budget(0);
    let failed=try_clone(item);
    println("{failed.tag} {allocated(failed.data[0])} {item.tag}");
    return 0;
}
