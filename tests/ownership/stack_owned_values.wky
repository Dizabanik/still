struct Pair { i64 tag; owner<i64> first; [2]owner<i64> others; ref<i64> borrowed; }
struct Outer { Pair item; [2]Pair more; }
fn make(i64 n) -> Pair {
    owner<i64> a = own(2);
    a[0] = n; a[1] = n+1;
    owner<i64> b = own(1); b[0] = n+2;
    let borrowed = ref_of(a);
    Pair p = {tag: n, first: move(a), others: {move(b)}, borrowed: borrowed};
    return move(p);
}
fn consume(Pair p) -> i64 { return p.first[0] + p.others[0][0] + p.tag; }
fn main() -> i32 {
    Pair a = make(11);
    ref<i64> view = ref_of(a.first);
    Pair b = clone(a);
    b.first[0] = 29;
    println("{a.first[0]} {b.first[0]} {view[1]}");
    Outer outer = {item: move(a)};
    Pair moved = move(outer.item);
    println("{moved.first[0]} {allocated(outer.item.first)} {consume(move(b))}");
    Pair fresh = {tag: 5, first: own(1)};
    fresh.first[0] = 37;
    moved = move(fresh);
    try_stable(view) { println("unexpected live"); } else { println("old stale"); }
    println("{moved.tag} {moved.first[0]}");
    [0]owner<i64> empty = {};
    [0]owner<i64> empty_copy = clone(empty);
    release(empty_copy);
    return 0;
}
