int calls = 0;

fn []u8 middle([]u8 bytes) {
    calls += 1;
    return bytes[1..3];
}

fn main() {
    const [3]u8 letters = {'a', 'b', 'c'};
    println("{letters}");
    [5]u8 bytes = {'x', 'a', 'b', 'y', 'z'};
    println("{middle(bytes)} calls={calls}");
    println("{bytes[2..2]}");
    [3]u8 nul = {'a', '\0', 'b'};
    println("{nul}");
    let text = "abcd";
    println("{text[1..3]}");
    return 0;
}
