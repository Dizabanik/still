// main with OS arguments: the wrapper converts C argv to sized str views.
// Zero-arg mains also get a synthesized wrapper (covered by every
// other test). Run without extra args: argc==1, argv[0] is the binary name.
import stdc;

@unsafe

fn int main(i32 argc, str* argv) {
    stdc.printf("argc>0=%d name_set=%d\n", argc > 0,
                argv[0][0] != 0);
    return 0;
}
