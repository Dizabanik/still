import stdc;

struct Vec2 { f32 x; f32 y; }

impl Vec2 {
    @unsafe
    fn Vec2 self_add(self, Vec2 o) {
        Vec2 r = { .x = self.x + o.x, .y = self.y + o.y };
        return r;
    }
    @unsafe
    fn Vec2 self_sub(self, Vec2 o) {
        Vec2 r = { .x = self.x - o.x, .y = self.y - o.y };
        return r;
    }
    @unsafe
    fn Vec2 self_mul(self, f32 k) {
        Vec2 r = { .x = self.x * k, .y = self.y * k };
        return r;
    }
    @unsafe
    fn Vec2 self_neg(self) {
        Vec2 r = { .x = -self.x, .y = -self.y };
        return r;
    }
    @unsafe
    fn bool self_eq(self, Vec2 o) {
        return self.x == o.x && self.y == o.y;
    }
}

@unsafe

fn i32 main() {
    Vec2 a = { .x = 1.0, .y = 2.0 };
    Vec2 b = { .x = 3.0, .y = 4.0 };
    Vec2 s = a + b;
    stdc.printf("add=%.1f %.1f\n", s.x, s.y);
    Vec2 d = b - a;
    stdc.printf("sub=%.1f %.1f\n", d.x, d.y);
    Vec2 m = a * 3.0;
    stdc.printf("mul=%.1f %.1f\n", m.x, m.y);
    Vec2 n = -a;
    stdc.printf("neg=%.1f %.1f\n", n.x, n.y);
    if (a + b == b + a) { stdc.printf("eq works\n"); }
    if (a == b) { stdc.printf("BAD\n"); } else { stdc.printf("ne works\n"); }
    a += b;
    stdc.printf("pluseq=%.1f %.1f\n", a.x, a.y);
    return 0;
}
