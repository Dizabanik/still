// std.process: arg_count/arg_at read the OS argv captured at startup.
// Under run.sh there are no extra args, so argc=1 (program name) and
// arg_at(0) starts with 't' for tests/test_process_args.wky? Not stable --
// just assert argc >= 1 and print a marker derived from it.
import stdc;

fn i32 main() {
    let n = std.process.arg_count();
    if (n < 1) { std.process.exit(1); }
    let first = std.process.arg_at(0);
    stdc.printf("argv0 ok=%d count=%d\n", 1, n);
    return 0;
}
