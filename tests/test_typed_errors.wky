#!/usr/bin/env wky run
// Typed errors (IDEAS 3): `dregs (ErrType e)` carries a payload struct.
// Still a plain store + branch -- no unwinding, nounwind survives, zero
// runtime overhead over the legacy i32 slot.

struct ParseErr {
    i32 code;
    i32 line;
}

struct IoErr {
    u32 fd;
    bool fatal;
}

fn i32 main() {
    // 1. Typed payload: press a struct, catch it with fields intact.
    filter {
        stdc.printf("t1: parsing\n");
        ParseErr payload = { .code = 3, .line = 17 };
        press err = payload;
        stdc.printf("t1: unreachable\n");
    } dregs (ParseErr err) {
        stdc.printf("t1: code=%d line=%d\n", err.code, err.line);
    }
    stdc.printf("t1: done\n");

    // 2. No press: catch skipped entirely.
    filter {
        stdc.printf("t2: ok path\n");
    } dregs (ParseErr e2) {
        stdc.printf("t2: caught %d\n", e2.code);
    }

    // 3. Nested typed filters: innermost handler wins.
    filter {
        filter {
            ParseErr p7 = { .code = 7, .line = 1 };
            press inner = p7;
        } dregs (ParseErr inner) {
            stdc.printf("t3: inner code=%d\n", inner.code);
        }
        stdc.printf("t3: outer try continues\n");
    } dregs (ParseErr outer) {
        stdc.printf("t3: outer code=%d\n", outer.code);
    }

    // 4. Legacy typeless dregs still works (i32 slot).
    filter {
        press old = 42;
    } dregs (old) {
        stdc.printf("t4: legacy %d\n", old);
    }

    // 5. Different payload types at different nesting levels.
    filter {
        filter {
            IoErr ioerr = { .fd = 9, .fatal = true };
            press io = ioerr;
        } dregs (IoErr io) {
            stdc.printf("t5: io fd=%u fatal=%d\n", io.fd, io.fatal);
        }
        stdc.printf("t5: outer try continues\n");
    } dregs (ParseErr never) {
        stdc.printf("t5: unreachable %d\n", never.code);
    }
    filter {
        ParseErr uperr = { .code = 5, .line = 99 };
        press up = uperr;
    } dregs (ParseErr up) {
        stdc.printf("t5: rethrown as ParseErr %d\n", up.line);
    }

    // 6. defer runs before the typed press transfers control.
    filter {
        defer stdc.printf("t6: cleanup\n");
        ParseErr boomerr = { .code = 11, .line = 4 };
        press boom = boomerr;
    } dregs (ParseErr boom) {
        stdc.printf("t6: caught code=%d\n", boom.code);
    }

    // 7. Typed error through a helper-shaped pattern: build the payload
    //    from runtime values.
    let base = 100;
    filter {
        ParseErr derived = { .code = base + 23, .line = base / 10 };
        press e = derived;
    } dregs (ParseErr e) {
        stdc.printf("t7: runtime payload %d %d\n", e.code, e.line);
    }

    // 8. Scalar payloads: u8 and f64 slots.
    filter {
        press small = 200;
    } dregs (u8 small) {
        stdc.printf("t8: u8 payload %d\n", ((i32)small));
    }
    filter {
        press ratio = 0.5;
    } dregs (f64 ratio) {
        stdc.printf("t8: f64 payload %.1f\n", ratio);
    }
}
