fn result<i32,i32> choose(bool flag) { if(flag) {return ok(1);} else {return err(2);} }
fn result<i32,i32> relay(bool flag) { match choose(flag) { Ok(v)=>{return ok(v+10);}, Err(e)=>{return err(e+20);} } }
fn main() { println("{match relay(true) {Ok(v)=>v,Err(e)=>e}} {match relay(false) {Ok(v)=>v,Err(e)=>e}}"); return 0; }
