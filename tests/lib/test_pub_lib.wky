pub struct Counter {
    pub i32 count;
}

pub impl Counter {
    pub const MAX = 1000;

    pub unsafe fn new(i32 start) Counter {
        return Counter { count: start };
    }

    pub unsafe fn inc(self*, i32 step) void {
        self.count += step;
    }

    pub unsafe fn get(self) i32 {
        return self.count;
    }
}

pub unsafe fn create_counter(i32 start) Counter {
    return Counter.new(start);
}
